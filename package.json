{
  "name": "hust-smartcourse-cli",
  "version": "1.1.0",
  "private": false,
  "type": "module",
  "description": "智慧华中大课程平台任务点自动化 CLI：视频 / 文档 / 测验，纯 HTTP 实现，含 CAS 登录与播放协议逆向",
  "keywords": [
    "chaoxing",
    "fanya",
    "mooc",
    "hust",
    "automation"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "login": "node src/login-qr.mjs",
    "login:pw": "node src/login-pw.mjs",
    "cred": "node src/cred.mjs",
    "import-cookies": "node src/import-cookies.mjs",
    "check": "node src/probe-session.mjs",
    "course": "node src/course.mjs",
    "scan": "node src/scan.mjs",
    "doc": "node src/doc.mjs",
    "play": "node src/play.mjs",
    "quiz": "node src/quiz.mjs",
    "test": "node test/mock-play.mjs"
