    "docs/",
    "config/",
    "data/",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xcdoge/hust-smartcourse-cli.git"
  },
  "homepage": "https://github.com/xcdoge/hust-smartcourse-cli#readme",
  "bugs": {
